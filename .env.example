# Personale Artificiale — variabili d'ambiente
# Copia in .env e sostituisci tutti i placeholder prima del deploy.

# Sicurezza/database: genera valori unici, lunghi e non riutilizzati.
POSTGRES_PASSWORD=replace_with_a_very_long_random_postgres_password
JWT_SECRET=replace_with_at_least_64_random_characters
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=20
ADMIN_EMAIL=admin@personaleartificiale.it
OTP_LOGIN_REQUIRED=true
OTP_SECRET=replace_with_at_least_64_random_characters
# Provider email OTP opzionale/consigliato in produzione.
# RESEND_API_KEY=re_replace_me
# Usa onboarding@resend.dev per test. In produzione sostituisci con un mittente del tuo dominio verificato su Resend.
OTP_EMAIL_FROM=Personale Artificiale <onboarding@resend.dev>

# URL pubblici
APP_URL=https://app.personaleartificiale.it
WWW_URL=https://www.personaleartificiale.it

# Coesistenza VPS: Personale Artificiale resta su loopback, così un altro sito
# può usare la porta 3000 e un reverse proxy host può usare 80/443.
PA_HTTP_PORT=8081

# Stripe live/test: usa le chiavi corrette per l'ambiente scelto.
# Solo per sviluppo locale: se impostato a true e usi domini .localhost,
# /api/stripe/checkout attiva il piano senza chiamare Stripe. NON abilitarlo in VPS.
DEV_BYPASS_BILLING=false
STRIPE_SECRET_KEY=«redacted:sk_live_…»
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_EXECUTIVE_MONTHLY=price_replace_me
STRIPE_PRICE_EXECUTIVE_SETUP=price_replace_me
STRIPE_PRICE_OFFICE_MONTHLY=price_replace_me
STRIPE_PRICE_OFFICE_SETUP=price_replace_me
STRIPE_PRICE_CREDITS_100K=price_replace_me
STRIPE_PRICE_CREDITS_500K=price_replace_me
# Add-on ricorrenti opzionali (integrazione extra 9€/mese, numero WhatsApp extra 5€/mese).
# Se non impostati, l'app crea automaticamente un prezzo Stripe dinamico allo stesso importo:
# consigliato comunque creare Price fissi in Stripe per un reporting più pulito.
# STRIPE_PRICE_EXTRA_INTEGRATION_MONTHLY=price_replace_me
# STRIPE_PRICE_EXTRA_WHATSAPP_NUMBER_MONTHLY=price_replace_me

# OpenRouter per chatbot e, se il modello/endpoint scelto lo supporta, embeddings RAG.
# Senza questa chiave il chatbot non va in crash: risponde con fallback locale sulle fonti disponibili.
OPENROUTER_API_KEY=replace_with_openrouter_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://app.personaleartificiale.it
OPENROUTER_APP_NAME=Personale Artificiale
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536

# Qdrant/Evolution
QDRANT_COLLECTION=pa_knowledge
# QDRANT_API_KEY=replace_me_if_using_qdrant_cloud
QDRANT_TIMEOUT_MS=8000
EVOLUTION_API_KEY=replace_with_a_long_random_evolution_key
EVOLUTION_TIMEOUT_MS=10000
WHATSAPP_BOT_NUMBER=+390000000000
WHATSAPP_PREFILLED_MESSAGE=Ciao, voglio aprire la chat con il mio assistente Personale Artificiale.
WHATSAPP_MAX_MSG_PER_MINUTE=10
WHATSAPP_SEND_DELAY_MIN_MS=1200
WHATSAPP_SEND_DELAY_MAX_MS=4500
WHATSAPP_DEFAULT_CREDIT_PACK=crediti-100k

# Servizio vocale (container "speech"): trascrizione messaggi vocali WhatsApp in ingresso
# (faster-whisper, locale, nessuna chiave esterna richiesta) e risposte audio via edge-tts,
# inviate solo quando il cliente lo chiede esplicitamente ("rispondimi con un audio").
SPEECH_TIMEOUT_MS=30000
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=it
EDGE_TTS_VOICE=it-IT-IsabellaNeural

# Modulo Coach obiettivi: ogni quanti giorni ricontattare il cliente per la review dell'obiettivo attivo
COACH_REVIEW_INTERVAL_DAYS=7

# Modulo Triage Backlog: sopra quante bozze email in sospeso proporre il triage, e ogni quante ore
# al massimo riproporlo automaticamente se il cliente non risponde
TRIAGE_BACKLOG_THRESHOLD=15
TRIAGE_PROPOSE_COOLDOWN_HOURS=24

# Servizio documenti (container "office"): genera/legge Excel, PowerPoint, Word e PDF
OFFICE_TIMEOUT_MS=30000

# Timeout più lungo per la trascrizione di video (download + eventuale Whisper fallback può richiedere minuti)
SPEECH_VIDEO_TIMEOUT_MS=180000

# Generazione immagini via Cloudflare Workers AI: crea un account Cloudflare (gratis, 10.000 neuroni/giorno
# inclusi), prendi l'Account ID dalla dashboard e crea un API Token con permessi "Workers AI - Read" e
# "Workers AI - Edit" su https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=replace_with_cloudflare_account_id
CLOUDFLARE_API_TOKEN=replace_with_cloudflare_api_token
CLOUDFLARE_TIMEOUT_MS=60000

# Integrazioni (Google Calendar, email IMAP/SMTP): chiave per cifrare le credenziali salvate
# per ogni cliente. Genera un valore lungo e casuale, diverso da tutti gli altri secret.
INTEGRATIONS_ENCRYPTION_KEY=replace_with_at_least_64_random_characters

# Google Calendar + Gmail + Google Drive: crea un progetto su https://console.cloud.google.com/,
# abilita "Google Calendar API", "Gmail API" e "Google Drive API", crea credenziali OAuth 2.0
# di tipo "Web application" e aggiungi TUTTI questi redirect URI allo stesso client OAuth:
#   ${APP_URL}/api/integrations/google/callback   (Google Calendar)
#   ${APP_URL}/api/integrations/gmail/callback    (Gmail)
#   ${APP_URL}/api/integrations/drive/callback    (Google Drive)
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
CALENDAR_BUSINESS_START_HOUR=9
CALENDAR_BUSINESS_END_HOUR=18

# Email (IMAP/SMTP): intervallo di controllo nuove email in arrivo, in millisecondi.
EMAIL_POLL_INTERVAL_MS=180000
